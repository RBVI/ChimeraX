<?xml version="1.0"?>
<BundleInfo name="ChimeraX-Graphics" version="1.4.1" package="chimerax.graphics" minSessionVersion="1" maxSessionVersion="1">
  <Author>UCSF RBVI</Author>
  <Email>chimerax@cgl.ucsf.edu</Email>
  <URL>https://www.rbvi.ucsf.edu/chimerax/</URL>
  <Synopsis>OpenGL graphics rendering</Synopsis>
  <Description>Render scenes using a camera, view and hierarchy of drawings.</Description>
  <DataFiles>
    <DataFile>vertexShader.txt</DataFile>
    <DataFile>fragmentShader.txt</DataFile>
    <DataFile>_graphics.*</DataFile>
    <DataFile>_metal.*</DataFile>
    <DataFile>_vulkan.*</DataFile>
    <DataFile>shaders/*.metal</DataFile>
    <DataFile>shaders/*.glsl</DataFile>
    <DataFile>shaders/*.vert</DataFile>
    <DataFile>shaders/*.frag</DataFile>
    <DataFile>shaders/*.comp</DataFile>
  </DataFiles>
  <Categories>
    <Category name="Graphics"/>
  </Categories>
  <CModule name="_graphics">
    <SourceFile>_graphics/blend_rgba.cpp</SourceFile>
    <SourceFile>_graphics/count.cpp</SourceFile>
    <SourceFile>_graphics/graphics.cpp</SourceFile>
    <SourceFile>_graphics/linux_swap_interval.cpp</SourceFile>
    <SourceFile>_graphics/mac_swap_interval.cpp</SourceFile>
    <SourceFile>_graphics/mesh_edges.cpp</SourceFile>
    <Library>arrays</Library>
    <Library platform="windows">opengl32.lib</Library>
    <Library platform="linux">GL</Library>
    <Framework>OpenGL</Framework>
  </CModule>
  <CModule name="_metal" platform="mac">
    <SourceFile>_metal/module.cpp</SourceFile>
    <SourceFile>_metal/metal_context.m</SourceFile>
    <SourceFile>_metal/metal_buffer.m</SourceFile>
    <SourceFile>_metal/metal_pipeline.m</SourceFile>
    <SourceFile>_metal/metal_texture.m</SourceFile>
    <SourceFile>_metal/metal_raytracing.m</SourceFile>
    <CompileArgument>-ObjC++</CompileArgument>
    <CompileArgument>-std=c++17</CompileArgument>
    <CompileArgument>-stdlib=libc++</CompileArgument>
    <Framework>Metal</Framework>
    <Framework>QuartzCore</Framework>
    <Framework>AppKit</Framework>
    <IncludeDir>_metal</IncludeDir>
  </CModule>
  <CModule name="_vulkan">
    <SourceFile>_vulkan/module.cpp</SourceFile>
    <SourceFile>_vulkan/vulkan_context.cpp</SourceFile>
    <SourceFile>_vulkan/vulkan_buffer.cpp</SourceFile>
    <SourceFile>_vulkan/vulkan_texture.cpp</SourceFile>
    <SourceFile>_vulkan/vulkan_pipeline.cpp</SourceFile>
    <SourceFile>_vulkan/vulkan_framebuffer.cpp</SourceFile>
    <SourceFile>_vulkan/vulkan_dummies.cpp</SourceFile>
    <SourceFile>_vulkan/vulkan_raytracing.cpp</SourceFile>
    <SourceFile>_vulkan/vk_shader.cpp</SourceFile>
    <SourceFile>_vulkan/VkBootstrap.cpp</SourceFile>
    <CompileArgument platform="windows">/std:c++17</CompileArgument>
    <CompileArgument platform="linux,mac">-std=c++17</CompileArgument>
    <IncludeDir>_vulkan</IncludeDir>
    <IncludeDir platform="windows">${VULKAN_SDK}/Include</IncludeDir>
    <IncludeDir platform="windows">${VULKAN_SDK}/Include/vma</IncludeDir>
    <IncludeDir platform="linux">${VULKAN_SDK}/include</IncludeDir>
    <IncludeDir platform="linux">${VULKAN_SDK}/include/vma</IncludeDir>
    <LibraryDir platform="windows">${VULKAN_SDK}/Lib</LibraryDir>
    <LibraryDir platform="linux">${VULKAN_SDK}/lib</LibraryDir>
    <Library platform="windows">vulkan-1.lib</Library>
    <Library platform="windows">shaderc_combined.lib</Library>
    <Library platform="linux">vulkan</Library>
    <Library platform="linux">shaderc_combined</Library>
  </CModule>
  <Dependencies>
    <Dependency name="ChimeraX-Core" version="~=1.3dev2021"/>
    <Dependency name="ChimeraX-Arrays" build="true" version="~=1.0"/>
    <Dependency name="ChimeraX-Geometry" version="~=1.0"/>
  </Dependencies>
  <Classifiers>
    <PythonClassifier>Development Status :: 2 - Pre-Alpha</PythonClassifier>
    <PythonClassifier>License :: Free for non-commercial use</PythonClassifier>
  </Classifiers>
</BundleInfo>
