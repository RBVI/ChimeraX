PREREQ_MAKE = 1
TOP = ../../../..
include $(TOP)/mk/config.make

include Makefile.common

# The configure script checks for the compiler banner message, so..
VERBOSE_CC := $(subst -nologo,,$(CC))
VERBOSE_CXX := $(subst -nologo,,$(CXX))
QUOTE_CC := $(subst ','\'',$(VERBOSE_CC) $(TARGET_ARCH))
QUOTE_CXX := $(subst ','\'',$(VERBOSE_CXX) $(TARGET_ARCH))

# Make xdrfile use our compiler options
ifeq ($(OS),Darwin)
ENV_CONFIGURE = MSYS2_ARG_CONV_EXCL=/OUT CC='$(QUOTE_CC)' CXX='$(QUOTE_CXX)' LDFLAGS="$(TARGET_ARCH) $(LDFLAGS) -Wl,-install_name,@rpath/libxdrfile.4.dylib" CFLAGS=
else
ENV_CONFIGURE = MSYS2_ARG_CONV_EXCL=/OUT CC='$(QUOTE_CC)' CXX='$(QUOTE_CXX)' LDFLAGS="$(TARGET_ARCH) $(LDFLAGS)" CFLAGS=
endif

PATCHES = rvec.patch

all: $(XDRFILE_LIB)

ifeq ($(OS),Darwin)
# configure takes many seconds to work out what is always true on macOS, so
# compile the three source files directly, with the definitions from the
# config.h configure made.  The result has the same code as libtool's.
XDRFILE_SRCS = xdrfile xdrfile_trr xdrfile_xtc
XDRFILE_CFLAGS = -DHAVE_INTTYPES_H=1 -DHAVE_STDINT_H=1 -DHAVE_RPC_XDR_H=1 \
	-DFLOAT_FORMAT_IEEE754 -Iinclude -O3 -fomit-frame-pointer \
	-finline-functions -Wall -Wno-unused -std=gnu99 -fexcess-precision=fast
$(XDRFILE_LIB): $(XDRFILE_LIB_SOURCE)
	mkdir -p $(XDRFILE_LIB_SOURCE)/src/.libs
	cd $(XDRFILE_LIB_SOURCE) && for f in $(XDRFILE_SRCS); do \
		$(CC) $(TARGET_ARCH) $(XDRFILE_CFLAGS) -c src/$$f.c -o src/.libs/$$f.o \
			|| exit 1 ; \
	done
	cd $(XDRFILE_LIB_SOURCE)/src/.libs && \
		$(CC) $(TARGET_ARCH) $(LDFLAGS) -dynamiclib \
			-install_name @rpath/libxdrfile.4.dylib \
			-compatibility_version 5.0.0 -current_version 5.0.0 \
			-o libxdrfile.4.dylib $(XDRFILE_SRCS:=.o) && \
		ln -sf libxdrfile.4.dylib libxdrfile.4.0.0.dylib && \
		ln -sf libxdrfile.4.dylib libxdrfile.dylib
else
$(XDRFILE_LIB): $(XDRFILE_LIB_SOURCE)
	cd $(XDRFILE_LIB_SOURCE) ; $(ENV_CONFIGURE) $(MAKE)
endif

$(XDRFILE_LIB_SOURCE):
	tar zxf $(XDRFILE_ARCHIVE) --no-same-owner
ifneq ($(PATCHES),)
	for p in $(PATCHES); do \
		if [ -f $$p ] ; then \
			(cd $(XDRFILE_LIB_SOURCE) ; patch -p0) < $$p ; \
		fi ; \
	done
endif
ifneq ($(OS),Darwin)
	cp configure.ac $(XDRFILE_LIB_SOURCE)/configure.ac
	# Make the shipped automake outputs newer than the replaced configure.ac,
	# or the first make reruns aclocal/autoconf/automake and then configure
	cd $(XDRFILE_LIB_SOURCE) ; touch aclocal.m4 ; autoconf ; \
		touch config.h.in Makefile.in src/Makefile.in src/python/Makefile.in include/Makefile.in
ifneq ($(filter $(MSYSTEM),MSYS MINGW64),)
	# Though it says 'mingw32' inspection of the generated static library shows x86_64
	cd $(XDRFILE_LIB_SOURCE) ; $(ENV_CONFIGURE) ./configure --build=x86_64-w64-mingw32 --enable-shared --with-pic
else
ifeq ($(OSARCH),LinuxArm64)
	cd $(XDRFILE_LIB_SOURCE)/config ; rm config.guess ; cp $(TOP)/utils/build/autotools/config.guess .
	cd $(XDRFILE_LIB_SOURCE)/config ; rm config.sub ; cp $(TOP)/utils/build/autotools/config.sub .
endif
	cd $(XDRFILE_LIB_SOURCE) ; $(ENV_CONFIGURE) ./configure --enable-shared --with-pic
endif
endif

clean:
	rm -rf $(PYMOD) $(OBJS) $(XDRFILE_LIB_SOURCE) $(BUILD)
ifdef WIN32
	rm -f $(PYMOD_NAME).exp $(PYMOD_NAME).lib
endif
